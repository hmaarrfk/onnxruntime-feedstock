From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Fri, 8 Aug 2026 00:00:00 -0400
Subject: [PATCH 7/7] Guard onnx import in autoep test

onnxruntime_test_python_autoep.py gained a module-level "import onnx"
in 1.28.0 (it had none in 1.27.0), but tools/ci_build/build.py runs it
unconditionally, before its explicit "onnx is not installed" gate that
protects the onnx-dependent test group. Only two tests in the file use
onnx (onnx.TensorProto constants); make the import optional and skip
those two tests when onnx is absent, mirroring the guards used in
onnxruntime_test_python.py. Not fixed upstream as of
microsoft/onnxruntime main @ 2026-08-08.
---
 onnxruntime/test/python/onnxruntime_test_python_autoep.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/onnxruntime/test/python/onnxruntime_test_python_autoep.py b/onnxruntime/test/python/onnxruntime_test_python_autoep.py
--- a/onnxruntime/test/python/onnxruntime_test_python_autoep.py
+++ b/onnxruntime/test/python/onnxruntime_test_python_autoep.py
@@ -10,6 +10,12 @@ from collections.abc import Sequence

 import numpy as np
-import onnx
+
+try:
+    import onnx
+except ImportError:
+    # tests that need onnx are skipped via skipUnless below
+    onnx = None
+
 from autoep_helper import AutoEpTestCase
 from helper import get_name

@@ -386,6 +392,7 @@ class TestAutoEP(AutoEpTestCase):
         del ort_value
         self.unregister_execution_provider_library(self.EXAMPLE_EP_NAME)

+    @unittest.skipUnless(onnx is not None, "onnx package is required")
     def test_ortvalue_from_shape_and_type_host_accessible_onnx_int_type(self):
         ep_device = self._register_example_plugin_ep_or_skip()
         mem_info = ep_device.memory_info(onnxrt.OrtDeviceMemoryType.HOST_ACCESSIBLE)
@@ -431,6 +438,7 @@ class TestAutoEP(AutoEpTestCase):
         with self.assertRaisesRegex(RuntimeError, "No shared allocator found"):
             onnxrt.OrtValue.ortvalue_from_shape_and_type([2], np.float32, memory_info=bogus_mem_info)

+    @unittest.skipUnless(onnx is not None, "onnx package is required")
     def test_ortvalue_from_shape_and_onnx_type_memory_info_string_rejected(self):
         ep_device = self._register_example_plugin_ep_or_skip()
         mem_info = ep_device.memory_info(onnxrt.OrtDeviceMemoryType.HOST_ACCESSIBLE)
